          "name": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "get_market_overview": {
      "description": "读取某市场当前已缓存的行情快照及涨跌家数统计，不抓取全网、不补造行情。",
      "parameters": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "CN",
              "HK",
              "US",
              "FUND",
              "GOLD"
            ]
          }
        },
        "required": [
          "market"
        ],
        "additionalProperties": false
