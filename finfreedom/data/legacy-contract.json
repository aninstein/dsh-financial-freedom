      "description": "查询单只中国公募基金已披露报告期的持仓，不代表实时组合。",
      "parameters": {
        "type": "object",
        "properties": {
          "fund_code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          }
        },
        "required": [
          "fund_code"
        ],
        "additionalProperties": false
      }
    },
