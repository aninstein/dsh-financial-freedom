        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    "get_sector_overview": {
      "description": "查询A股行业板块的行情、成分股、涨跌统计和来源可用的行业主力资金。行业资金流不是北向资金或基金申赎。",
