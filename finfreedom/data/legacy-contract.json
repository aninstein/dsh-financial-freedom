  "research_tools": {
    "get_investment_memory": {
      "description": "检索当前用户的投资记忆：近期 daily、短期计划和长期偏好。只用于理解历史语境；价格、账户与交易仍须重新查询权威工具。不能读取原始历史 session。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    "get_memory_entry": {
      "description": "按记忆 ID 查看当前用户的一条有效记忆、状态和来源锚点；不返回原始会话。",
      "parameters": {
        "type": "object",
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          }
        },
        "required": [
          "entry_id"
        ],
        "additionalProperties": false
      }
    },
    "get_watchlist": {
      "description": "读取本地自选标的及最近缓存报价，供每日逐只操作建议使用；未返回的标的不作推断。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "get_market_news": {
      "description": "获取最近已采集财经快讯，可按行业/关键词筛选。必须引用发布时间、首次采集时间及来源；关键词关联不是因果。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 80
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "get_macro_liquidity": {
      "description": "读取央行官方公开市场逆回购公告，分期限操作量、利率及原文。到期额或净投放缺失不推算；不等同个人国债逆回购交易。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "get_sector_rotation": {
      "description": "行业今日/5日/10日收益排名、资金分类及本机跨采集日快照。跨窗口改善不等于跨日轮动变化，说明共同集合与源时点缺口。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "read_uploaded_document": {
      "description": "按文档ID阅读研报/财报原文，返回一个页面最多6000字符及下一页/偏移；引用页码，未读取内容不能声称已读。",
      "parameters": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "document_id"
        ],
        "additionalProperties": false
      }
    },
    "get_historical_cycles": {
      "description": "基于完整历史日线计算阶段收益、波动、最大回撤、月度季节性和收益自相关。只描述历史，不能作为预测。",
      "parameters": {
        "type": "object",
        "properties": {
          "instrument_id": {
            "type": "string"
          },
          "years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "instrument_id"
        ],
        "additionalProperties": false
      }
    },
    "get_index_analysis": {
      "description": "查询指数目录（不传ID）或分析上证、深成、沪深300、中证500、创业板、科创50、恒生、标普500、道琼斯、纳斯达克历史趋势。指数点位不能下单。",
      "parameters": {
        "type": "object",
        "properties": {
          "index_id": {
            "type": "string"
          },
          "years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "get_market_flow_history": {
      "description": "查询沪深大盘最近资金分类历史；金额为元，来源估计资金不等于北向、基金真实流水。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "collect_fund_disclosures": {
      "description": "有界采集1至5只指定中国公募基金报告期持仓，逐只缓存及报告缺口，不能声称抓到了全市场实时操作。",
      "parameters": {
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          }
        },
        "required": [
          "codes"
        ],
        "additionalProperties": false
      }
    },
    "get_stock_dossier": {
      "description": "聚合个股公司概况、盘口估值、财务、股东户数、分红、资金、新闻及公告。按分项状态和原始报告期引用，字段缺失不补造；资金不是北向真实流水。",
      "parameters": {
        "type": "object",
        "properties": {
          "instrument_id": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "profile",
                "snapshot",
                "financials",
                "ownership",
                "dividends",
                "flow",
                "news",
                "announcements",
                "income",
                "balance",
                "cashflow",
                "holders",
                "business",
                "reports"
              ]
            },
            "maxItems": 4
          }
        },
        "required": [
          "instrument_id"
        ],
        "additionalProperties": false
      }
    },
    "search_instruments": {
      "description": "按用户说的股票名称或代码查找已接入的证券，先确认名称和规范代码再做分析。",
