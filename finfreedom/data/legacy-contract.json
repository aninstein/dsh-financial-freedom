      "parameters": {
        "type": "object",
        "properties": {
          "fund_code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          },
          "direction": {
            "type": "string",
            "enum": [
              "buy",
              "sell",
              "both"
            ]
          }
