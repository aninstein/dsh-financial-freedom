        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "asset_class": {
            "type": "string",
            "enum": [
              "all",
              "etf",
              "mutual_fund"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "additionalProperties": false
      }
    },
    "search_fund_directory": {
      "description": "搜索东方财富公募基金目录，覆盖债券、ETF、LOF、QDII、FOF、货币、REITs 等；目录包含历史基金，需另核实当前申购状态。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 80
          },
          "category": {
            "type": "string",
            "enum": [
              "all",
              "债券",
              "ETF",
              "LOF",
              "QDII",
              "FOF",
              "货币",
              "REITs",
              "股票",
              "混合",
              "指数",
              "其他"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "get_fund_research": {
      "description": "读取指定基金的历史净值、阶段收益、经理、公司、费用、申赎状态、定期持仓和相邻披露权重变化；缺失的盘中估值保持空值。",
      "parameters": {
        "type": "object",
        "properties": {
          "fund_code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "fund_code"
        ],
        "additionalProperties": false
      }
    },
