      "description": "读取 AKShare 可返回的 A 股财务摘要，按原始报告期和来源呈现；字段缺失保持缺失。",
      "parameters": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "symbol"
        ],
        "additionalProperties": false
