    "get_instrument_research": {
      "description": "读取单个标的行情、历史日线、技术指标及交易日历状态；缺失日线应报告数据缺口。",
      "parameters": {
        "type": "object",
        "properties": {
          "instrument_id": {
            "type": "string",
            "description": "格式 MARKET:SYMBOL"
          },
          "days": {
            "type": "integer",
            "minimum": 20,
            "maximum": 500
          }
        },
        "required": [
          "instrument_id"
        ],
        "additionalProperties": false
      }
