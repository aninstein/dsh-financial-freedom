{
  "name": "@finfreedom/dsh-plugin",
  "version": "0.1.0",
  "description": "finfreedom MCP and Skills bundle for DeepSeek Harness",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "finfreedom/**/*.py",
    "finfreedom/data/*.json",
    "pyproject.toml",
    "skills",
    "ui",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    ".": "./ui/host.mjs",
    "./client": "./ui/client.js",
    "./package.json": "./package.json",
    "./skills": "./ui/skills.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.1-rc.2"
  }
}
