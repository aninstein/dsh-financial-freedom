{
  "name": "@finfreedom/dsh-plugin",
  "version": "0.1.0",
  "description": "finfreedom: a personal investment research workspace, MCP tools and skills for DeepSeek Harness",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "finfreedom/**/*.py",
    "finfreedom/data/*.json",
    "pyproject.toml",
    "skills",
    "ui",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SUBMISSION.md"
  ],
  "exports": {
    ".": "./ui/host.mjs",
    "./client": "./ui/client.js",
    "./package.json": "./package.json",
    "./skills": "./ui/skills.mjs",
    "./mcp": "./ui/mcp.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.1-rc.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "利长安",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aninstein/dsh-financial-freedom.git"
  },
  "homepage": "https://github.com/aninstein/dsh-financial-freedom",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "investment",
    "finance",
    "mcp",
    "skills"
  ],
  "icon": "ui/original/finfreedom-mark.svg",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2"
  }
}
